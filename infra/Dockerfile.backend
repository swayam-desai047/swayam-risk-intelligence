FROM python:3.12-slim

WORKDIR /app

# Install standard compiler dependencies for SHAP and Scikit-learn
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install UV inside container for rapid packages installation
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy python requirements
COPY backend/requirements.txt .

# Install dependencies globally
RUN uv pip install --system -r requirements.txt

# Copy ML pipeline models and core backend packages
COPY ml_pipeline /app/ml_pipeline
COPY backend /app/backend

EXPOSE 8000

# Start Uvicorn production server
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
